{
  "name": "pointwise-analytics",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @pointwise/sdk",
    "dev:server": "npm run dev -w @pointwise/server",
    "dev:web": "npm run dev -w @pointwise/web",
    "dev": "node scripts/dev.mjs",
    "test": "node --import tsx --test tests/filter.test.ts tests/server.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true
  }
}
